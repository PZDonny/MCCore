<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.donnypz.mccore</groupId>
        <artifactId>core</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>loader</artifactId>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>

                        <configuration>
                            <finalName>mccore</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <dependencies>

        <dependency>
            <groupId>net.donnypz.mccore</groupId>
            <artifactId>api</artifactId>
        </dependency>

        <dependency>
            <groupId>net.donnypz.mccore</groupId>
            <artifactId>v1_21_1</artifactId>
        </dependency>

        <dependency>
            <groupId>net.donnypz.mccore</groupId>
            <artifactId>v1_21_3</artifactId>
        </dependency>

        <dependency>
            <groupId>net.donnypz.mccore</groupId>
            <artifactId>v1_21_4</artifactId>
        </dependency>

        <dependency>
            <groupId>net.donnypz.mccore</groupId>
            <artifactId>v1_21_5</artifactId>
        </dependency>

        <dependency>
            <groupId>net.donnypz.mccore</groupId>
            <artifactId>v1_21_6</artifactId>
        </dependency>

        <dependency>
            <groupId>net.donnypz.mccore</groupId>
            <artifactId>v1_21_8</artifactId>
        </dependency>


        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

</project>